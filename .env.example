# HTTP server
PORT=3000

# PostgreSQL (accounts, balances)
DATABASE_URL=postgresql://user:password@localhost:5432/postgres

# MongoDB (transaction history)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/transactions

# JWT
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_EXPIRES_IN=1h

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=transactions
